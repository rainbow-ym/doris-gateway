# 管理界面自身账号，密码至少12位。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 生成方式：openssl rand -base64 32；生成后必须固定保存。
ADMIN_MASTER_KEY_B64=CHANGE_ME_32_BYTE_BASE64_KEY

# Proxy 同步执行 SQL 预校验、提交/中止以及上报血缘时使用，至少24个字符；Proxy 与管理平台必须一致。
LINEAGE_INGRESS_TOKEN=CHANGE_ME_LINEAGE_TOKEN_AT_LEAST_24_CHARS

# 管理界面监听地址和端口。建议仅绑定管理网IP。
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=18080

# ShardingSphere Proxy 地址。管理后台通过 DistSQL 发布规则。
PROXY_HOST=127.0.0.1
PROXY_PORT=3307
PROXY_ADMIN_USER=gateway_admin
PROXY_ADMIN_PASSWORD=CHANGE_ME_PROXY_ADMIN_PASSWORD

# H2 文件数据库密码，可使用另外一个高强度密码。
ADMIN_DB_PASSWORD=CHANGE_ME_H2_PASSWORD
