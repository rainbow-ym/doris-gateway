FROM doris-security-gateway-admin:multi-user-20261014
COPY gateway-platform-0.1.0.jar /opt/gateway-platform/app.jar
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD ["/usr/bin/bash", "-c", "exec 3<>/dev/tcp/${PLATFORM_BIND_ADDRESS:-127.0.0.1}/${PLATFORM_PORT:-18080}"]
ENTRYPOINT ["java", "-Xms128m", "-Xmx512m", "-Dfile.encoding=UTF-8", "-jar", "/opt/gateway-platform/app.jar"]
