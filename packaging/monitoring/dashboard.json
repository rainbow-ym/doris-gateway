{
  "uid": "gateway-capacity",
  "title": "网关加解密容量与质量",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "gateway"
  ],
  "templating": {
    "list": [
      {
        "name": "component",
        "type": "custom",
        "query": "worker,proxy",
        "current": {
          "text": "worker",
          "value": "worker"
        }
      },
      {
        "name": "operation",
        "type": "custom",
        "query": "ENCRYPT_QUERY,DECRYPT_FILE",
        "current": {
          "text": "ENCRYPT_QUERY",
          "value": "ENCRYPT_QUERY"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "容器内存/限额",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_cgroup_memory_used_bytes/gateway_cgroup_memory_limit_bytes",
          "legendFormat": "{{stage}}{{outcome}}{{job}}{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "容器 CPU 限流秒/秒",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(gateway_cgroup_cpu_throttled_seconds_total[$__rate_interval])",
          "legendFormat": "{{stage}}{{outcome}}{{job}}{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "容器内存采集覆盖",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_cgroup_memory_available",
          "legendFormat": "{{stage}}{{outcome}}{{job}}{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "所选时间成功请求总数",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gateway_export_duration_seconds_count{component=\"$component\",operation=\"$operation\",outcome=\"SUCCESS\"}[$__range]))",
          "legendFormat": "{{stage}}{{outcome}}{{job}}{{mountpoint}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "所选时间成功行数",
      "datasource": {
        "type": "prometheus",
        "uid": "gateway-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gateway_export_measure_total{component=\"$component\",operation=\"$operation\",outcome=\"SUCCESS\",measure=\"ROWS\"}[$__range]))",
          "legendFormat": "{{stage}}{{outcome}}{{job}}{{mountpoint}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none"
      }
    },
